// Prisma schema for Postgres connection
// Adjust database URL in .env file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  presets   Preset[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Preset {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String
  author      User     @relation(fields: [authorId], references: [id])
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
